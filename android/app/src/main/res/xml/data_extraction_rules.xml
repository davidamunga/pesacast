<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (cloud backup and device-to-device transfer). The app keeps a WiFi pairing token,
    webhook credentials and a queue of unsent transactions in private storage. None of it should be
    copied off the device or restored on another one, so everything is excluded (ADR-0014).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
